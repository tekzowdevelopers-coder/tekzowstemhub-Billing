# ==========================================
# TEKZOW STEMHUB BILLING - ENVIRONMENT KEYS
# ==========================================

# 1. Database Connection String (Required for Cloud/Vercel PostgreSQL deployment)
# If using Vercel Postgres, this is automatically configured for you!
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/tekzow_billing?sslmode=require"

# 2. Vercel Postgres Connection Pooling (Optional, auto-provided by Vercel Storage)
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/tekzow_billing?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/tekzow_billing?sslmode=require"

# 3. Next.js App URL (Optional, for absolute redirects/receipt links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. WhatsApp Cloud API / Provider Credentials (Optional)
# The system currently uses instant universal click-to-chat deep-links (zero external cost).
# Configure only if you integrate WhatsApp Cloud API in the future:
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
